<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-FileCopyrightText: 2026 Project Mist OS
     SPDX-License-Identifier: Apache-2.0

     Update card: version, meta chips, step tracker and the big primary action.
     Live progress is shown large in the hero; the card shows the text details.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    android:focusable="true"
    android:nextFocusRight="@+id/update_action"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/build_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textFontWeight="600"
                    tools:text="MistOS 5.1-Beta MINI" />

                <TextView
                    android:id="@+id/build_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="17 October 2026" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/update_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_update_options"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/update_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="0dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/build_size"
                style="@style/Widget.Updater.Chip.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_download"
                tools:text="3.1 GB" />

            <com.google.android.material.chip.Chip
                android:id="@+id/build_type_chip"
                style="@style/Widget.Updater.Chip.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_layers"
                tools:text="MINI" />

            <com.google.android.material.chip.Chip
                android:id="@+id/build_release_chip"
                style="@style/Widget.Updater.Chip.Release"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_verified"
                tools:text="OFFICIAL"
                tools:visibility="visible" />

            <com.google.android.material.chip.Chip
                android:id="@+id/build_device_chip"
                style="@style/Widget.Updater.Chip.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_phone"
                tools:text="Pixel 6a" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Progress details (the big wavy bar lives in the hero). -->
        <LinearLayout
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="1.2 GB of 3.1 GB (3 minutes left)" />

            <TextView
                android:id="@+id/progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorPrimary"
                tools:text="38%" />
        </LinearLayout>

        <!-- Step tracker: download → verify → install → restart -->
        <LinearLayout
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <include
                android:id="@+id/step_1"
                layout="@layout/update_step" />

            <include
                android:id="@+id/step_2"
                layout="@layout/update_step" />

            <include
                android:id="@+id/step_3"
                layout="@layout/update_step" />

            <include
                android:id="@+id/step_4"
                layout="@layout/update_step" />
        </LinearLayout>

        <TextView
            android:id="@+id/update_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="12dp"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            tools:drawableStart="@drawable/ic_wifi"
            tools:text="Use Wi‑Fi for this 3.1 GB download. Your apps and data stay as they are."
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/update_secondary"
                style="@style/Widget.Updater.Button.Big.Outlined"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:visibility="gone"
                tools:text="Cancel"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@id/update_action"
                style="@style/Widget.Updater.Button.Big"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1.4"
                tools:icon="@drawable/ic_pause"
                tools:text="Pause" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
