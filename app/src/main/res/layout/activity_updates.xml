<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:collapsedTitleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:contentScrim="?attr/colorPrimaryContainer"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:scrimAnimationDuration="220"
            app:statusBarScrim="@android:color/transparent"
            app:titleCollapseMode="fade"
            app:toolbarId="@id/toolbar">

            <LinearLayout
                android:id="@+id/hero_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="88dp"
                android:paddingEnd="28dp"
                android:paddingBottom="32dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.4">

                <FrameLayout
                    android:id="@+id/hero_art"
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/hero_shape"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/shape_cookie_9"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.loadingindicator.LoadingIndicator
                        android:id="@+id/hero_loading"
                        style="@style/Widget.Material3.LoadingIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:indicatorSize="112dp"
                        app:containerWidth="136dp"
                        app:containerHeight="136dp" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/hero_ring"
                        style="@style/Widget.Material3Expressive.CircularProgressIndicator.Wavy"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:max="100"
                        android:visibility="gone"
                        app:indicatorSize="136dp"
                        app:trackThickness="8dp" />

                    <ImageView
                        android:id="@+id/hero_icon"
                        android:layout_width="84dp"
                        android:layout_height="51dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/display_name"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mist"
                        app:tint="?attr/colorOnPrimary" />

                    <TextView
                        android:id="@+id/hero_ring_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textFontWeight="600"
                        android:visibility="gone"
                        tools:text="64%" />

                    <ImageView
                        android:id="@+id/hero_badge"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-6dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="?attr/colorTertiary"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_check"
                        app:tint="?attr/colorOnTertiary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/hero_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="?attr/colorTertiary"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnTertiary"
                    android:visibility="gone"
                    tools:text="New update"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textAppearance="@style/TextAppearance.Updater.Hero"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="You’re up\nto date" />

                <TextView
                    android:id="@+id/hero_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.86"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="MistOS 5.1-Beta · Pixel 6a" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/hero_progress"
                    style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:max="100"
                    android:visibility="gone"
                    app:trackThickness="6dp"
                    tools:progress="38"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/hero_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/hero_stat_size_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/hero_stat_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textFontWeight="600"
                            tools:text="1.2 GB" />

                        <TextView
                            android:id="@+id/hero_stat_size_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            tools:text="of 3.1 GB" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hero_stat_speed_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/hero_stat_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textFontWeight="600"
                            tools:text="12.4 MB/s" />

                        <TextView
                            android:id="@+id/hero_stat_speed_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:text="@string/stat_speed"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hero_stat_eta_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/hero_stat_eta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textFontWeight="600"
                            tools:text="3 min" />

                        <TextView
                            android:id="@+id/hero_stat_eta_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:text="@string/stat_left"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/header_last_check"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_pill"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    app:drawableStartCompat="@drawable/ic_schedule"
                    tools:text="Last checked: 13 November 2026 (10:42)" />
            </LinearLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="120dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                tools:itemCount="1"
                tools:listitem="@layout/update_item_view"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/no_new_updates_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="32dp"
                android:paddingTop="4dp">

                <com.mist.updater.RandomMessageTextView
                    android:id="@+id/no_updates_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </FrameLayout>

            <TextView
                android:id="@+id/section_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="28dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"
                android:text="@string/section_this_device"
                android:textAppearance="@style/TextAppearance.Updater.Section" />

            <LinearLayout
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical">

                <!-- MistOS version: wide tile -->
                <LinearLayout
                    android:id="@+id/tile_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tile"
                    android:gravity="center_vertical"
                    android:minHeight="96dp"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp">

                        <ImageView
                            android:id="@+id/tile_version_shape"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/shape_cookie_9"
                            app:tint="?attr/colorPrimary" />

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_mist"
                            app:tint="?attr/colorOnPrimary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tile_version"
                            android:textAppearance="@style/TextAppearance.Updater.TileLabel" />

                        <TextView
                            android:id="@+id/tile_version_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textFontWeight="600"
                            tools:text="5.1-Beta" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tile_device"
                        style="@style/Widget.Updater.Tile">

                        <ImageView
                            style="@style/Widget.Updater.TileIcon"
                            android:src="@drawable/ic_phone" />

                        <TextView
                            android:id="@+id/tile_device_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/TextAppearance.Updater.TileLabel"
                            tools:text="Device · bluejay" />

                        <TextView
                            android:id="@+id/tile_device_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textAppearance="@style/TextAppearance.Updater.TileValue"
                            tools:text="Pixel 6a" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_android"
                        style="@style/Widget.Updater.Tile"
                        android:layout_marginStart="8dp">

                        <ImageView
                            style="@style/Widget.Updater.TileIcon"
                            android:src="@drawable/ic_android" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/tile_android"
                            android:textAppearance="@style/TextAppearance.Updater.TileLabel" />

                        <TextView
                            android:id="@+id/header_build_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Updater.TileValue"
                            tools:text="17" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tile_build_date"
                        style="@style/Widget.Updater.Tile">

                        <ImageView
                            style="@style/Widget.Updater.TileIcon"
                            android:src="@drawable/ic_calendar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/tile_build_date"
                            android:textAppearance="@style/TextAppearance.Updater.TileLabel" />

                        <TextView
                            android:id="@+id/header_build_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textAppearance="@style/TextAppearance.Updater.TileValue"
                            tools:text="17 Oct 2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_build_type"
                        style="@style/Widget.Updater.Tile"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="?attr/colorTertiaryContainer">

                        <ImageView
                            style="@style/Widget.Updater.TileIcon"
                            android:backgroundTint="?attr/colorTertiary"
                            android:src="@drawable/ic_layers"
                            app:tint="?attr/colorOnTertiary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/tile_build_type"
                            android:textAppearance="@style/TextAppearance.Updater.TileLabel"
                            android:textColor="?attr/colorOnTertiaryContainer" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/header_build_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.03"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textAppearance="@style/TextAppearance.Updater.TileValue"
                                android:textColor="?attr/colorOnTertiaryContainer"
                                android:textFontWeight="600"
                                tools:text="MINI" />

                            <!-- Release type badge: OFFICIAL / UNOFFICIAL -->
                            <TextView
                                android:id="@+id/build_release_badge"
                                style="@style/Widget.Updater.ReleaseBadge"
                                android:layout_marginStart="8dp"
                                android:visibility="gone"
                                tools:text="OFFICIAL"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Maintainer card -->
                <LinearLayout
                    android:id="@+id/tile_maintainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tile"
                    android:backgroundTint="?attr/colorSecondaryContainer"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:clipChildren="false">

                            <ImageView
                                android:id="@+id/tile_maintainer_shape"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:src="@drawable/shape_sunny_12"
                                app:tint="?attr/colorSecondary" />

                            <TextView
                                android:id="@+id/tile_maintainer_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                                android:textColor="?attr/colorOnSecondary"
                                android:textFontWeight="700"
                                tools:text="Z" />

                            <ImageView
                                android:id="@+id/tile_maintainer_verified"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="-2dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="?attr/colorPrimary"
                                android:contentDescription="@string/maintainer_verified"
                                android:padding="5dp"
                                android:src="@drawable/ic_verified"
                                app:tint="?attr/colorOnPrimary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:text="@string/tile_maintainer"
                                android:textAppearance="@style/TextAppearance.Updater.TileLabel"
                                android:textColor="?attr/colorOnSecondaryContainer" />

                            <TextView
                                android:id="@+id/maintainer_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                                android:textColor="?attr/colorOnSecondaryContainer"
                                android:textFontWeight="600"
                                tools:text="Zabuka_Zuzu" />

                            <TextView
                                android:id="@+id/maintainer_role"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.85"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="?attr/colorOnSecondaryContainer"
                                tools:text="Official maintainer · Pixel 6a" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/maintainer_contact"
                            style="@style/Widget.Updater.Button.Small"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/maintainer_contact"
                            app:icon="@drawable/ic_telegram" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/maintainer_changelog"
                            style="@style/Widget.Updater.Button.Small.Tonal"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/changelog_title"
                            app:icon="@drawable/ic_changelog" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/header_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="28dp"
                android:paddingTop="24dp"
                android:paddingBottom="10dp"
                android:text="@string/section_support"
                android:textAppearance="@style/TextAppearance.Updater.Section" />

            <!-- Support + donation tiles. Code arranges the visible ones two per row
                 (an odd last tile takes the full row). -->
            <LinearLayout
                android:id="@+id/support_icons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:clipChildren="false">

                <include
                    android:id="@+id/support_telegram"
                    layout="@layout/support_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/support_forum"
                    layout="@layout/support_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/support_recovery"
                    layout="@layout/support_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/support_paypal"
                    layout="@layout/support_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/support_upi"
                    layout="@layout/support_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/support_coffee"
                    layout="@layout/support_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/changelog_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <ImageView
                    style="@style/Widget.Updater.TileIcon"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:src="@drawable/ic_changelog"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/changelog_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/changelog_summary"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_refresh"
            style="@style/Widget.Updater.Button.Big"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/action_check_updates"
            app:icon="@drawable/ic_refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_local_update"
            style="@style/Widget.Updater.Button.Square"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/local_update_import"
            android:tooltipText="@string/local_update_import"
            app:icon="@drawable/ic_local_update" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
